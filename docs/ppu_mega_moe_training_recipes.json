    "chip": "ZW-M890P",
    "architecture": "ppu0015",
    "sdk": "2.2.0-663c22",
    "torch": "2.11.0",
    "devices_per_host": 8,
    "hosts_per_supernode": 8
  },
  "global_experts": 512,
  "topk": 10,
  "precision_note": "Both paths use rowwise E4M3 activations, blockwise FP8 weights and K128 FP8 DW with F32 accumulation/output. MegaMoE may reuse row-FP8 source caches for DW; matching formats do not imply identical quantization boundaries.",
  "architecture_note": "Qwen3.5-397B-A17B uses H4096/I1024/E512/top-k10, verified against the official config. Qwen3.8-2.4T-A95B uses H8192/I2048/E512/top-k10, verified against the supplied checkpoint config. Tokens per rank are benchmark workload choices; checkpoint MXFP4 weights are not loaded.",
  "target_2_to_3x_achieved": false,
  "bf16_transport_note": "Qwen3.5-397B-A17B BF16 peer recipes use validated mode2 shared-memory batch NCP return; Qwen3.8-2.4T-A95B BF16 and all FP8/DeepEP recipes use mode0. This is a transport change; BF16 operands and F32 DW remain unchanged.",
  "control_collective_note": "Peer plans disable Torch control MNNVL for metadata startup stability; their hot data path uses custom same-supernode P2P. DeepEP controls explicitly enable MNNVL and must report one scale-out group, preserving the complete physical-supernode fast path. Timings with multiple DeepEP scale-out groups are excluded.",
  "source_pipeline_note": "Selected shape-specific policies: Qwen3.5-397B-A17B uses inline forward bulk ILP8 and 512-thread/39-CTA backward bulk ILP8; Qwen3.8-2.4T-A95B uses 6 forward source CTAs and 33 GEMM CTAs at EP32/EP64, plus 512-thread/39-CTA backward bulk ILP4. DW pack grid is 8 CTAs per CU.",
  "deepep_preparation": {
    "helper": "tests/benchmark_mega_moe_training.py --prepare-deepep-compat",
    "required_for_tested_sdk_wheel": true,
    "compatibility_identity_file": "build/campaign/deepep-native-scope/compat-manifest.json"
  },
