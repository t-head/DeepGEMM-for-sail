# cover distribution random type and moe api type
[DeepGemm] --format=GroupedMasked,data_type:fp8,groups:16,m:4096,n:4096,k:7168,em:12,distribution:[45,200,30,18,13,21,31,3,5,17,17,16,18,15,18,13]
