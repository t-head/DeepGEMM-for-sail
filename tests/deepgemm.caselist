[DeepGemm] --format=GroupedContiguous,data_type:fp8,groups:16,m:4096,n:4096,k:7168,em:12,distribution:normal
[DeepGemm] --format=GroupedContiguous,data_type:bf16,groups:16,m:4096,n:4096,k:7168,em:12,distribution:gaussian
[DeepGemm] --format=GroupedContiguous,data_type:int8,groups:16,m:4096,n:4096,k:7168,em:12,distribution:zipf
