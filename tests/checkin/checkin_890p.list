# DeepGEMM PR check-in caselist for Zhenwu 890P
# Run with: python tests/run_deep_gemm.py --caselist tests/checkin/checkin_890p.list
# Minimal per-type correctness set, superset of checkin_810e.list: adds the
# 890P-only dtypes (fp8 / fp4 / tf32 / w4fa16) on the same core shapes.
# Sections are split per UT type; append new cases under the matching section.

# ============ DenseGemm ============

# --- DenseGemm / bf16 ---
DenseGemm,data_type:bf16,m:2048,n:4096,k:7168
DenseGemm,data_type:bf16,m:2048,n:512,k:7168
DenseGemm,data_type:bf16,m:256,n:4096,k:7168
DenseGemm,data_type:bf16,m:256,n:512,k:7168

# --- DenseGemm / int8 ---
DenseGemm,data_type:int8,m:2048,n:4096,k:7168
DenseGemm,data_type:int8,m:2048,n:512,k:7168

# --- DenseGemm / fp8 ---
DenseGemm,data_type:fp8,m:2048,n:4096,k:7168
DenseGemm,data_type:fp8,m:2048,n:4096,k:7168,quant_type:channel

# --- DenseGemm / tf32 ---
DenseGemm,data_type:tf32,m:8192,n:24,k:16384

