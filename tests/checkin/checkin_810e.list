GroupedContiguous,data_type:bf16,groups:16,m:4096,n:4096,k:7168,distribution:gaussian
GroupedContiguous,data_type:bf16,groups:32,m:8192,n:2048,k:2048,distribution:uniform

# ============ GroupedFused ============

