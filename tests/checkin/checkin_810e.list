# DeepGEMM PR check-in caselist for Zhenwu 810E
# Run with: python tests/run_deep_gemm.py --caselist tests/checkin/checkin_810e.list
# Minimal per-type correctness set: each gemm type / dtype keeps a small number of
# representative shapes only. FP4/FP8 and W4A16 MXFP4 MMA require 890P.
# W4A16 INT4 and MXFP4 VALU paths are covered on both 810E and 890P.
# MQA coverage focuses on INT8, plus one BF16 smoke case.
# Sections are split per UT type; append new cases under the matching section.

# ============ DenseGemm ============

# --- DenseGemm / bf16 ---
# External LUT precedence, explicit override, miss and invalid tile rejection.
DenseGemm,data_type:bf16,m:128,n:256,k:1024,device:810e,runtime_lut:1
# Small M with M/N tails and a final partial BK128 tile.
DenseGemm,data_type:bf16,m:37,n:2056,k:1056
DenseGemm,data_type:bf16,m:2048,n:4096,k:7168
DenseGemm,data_type:bf16,m:104,n:8192,k:384,device:810e,num_sms:20
# BM96 uses a power-of-two warp grid and handles an incomplete final M tile.
DenseGemm,data_type:bf16,m:65,n:8192,k:1536,device:810e,accumulate:separate
# Sub-vector output with short K must use guarded scalar GEMV stores.
DenseGemm,data_type:bf16,m:1,n:2,k:32,device:810e,num_sms:20
# C aliasing and cancellation before BF16 rounding; N=1 GEMV product.
DenseGemm,data_type:bf16,m:2,n:1,k:96,device:810e,accumulate:alias,pattern:cancellation
# TSM split-K product with BF16 output and aliased C/D.
DenseGemm,data_type:bf16,m:36,n:288,k:4096,device:810e,accumulate:alias
# Generalized two-row GEMV, including accumulation before BF16 rounding.
DenseGemm,data_type:bf16,m:2,n:40,k:160,device:810e,accumulate:alias,pattern:cancellation
# A partial output vector needs scalar stores even with a one-CU budget.
DenseGemm,data_type:bf16,m:129,n:4,k:128,device:810e,num_sms:1
# Unsupported tiled K and misaligned BF16 inputs must fail before launch.
DenseGemm,data_type:bf16,m:7,n:16,k:33,device:810e,accumulate:alias,expect_error:K%32=0
DenseGemm,data_type:bf16,m:7,n:16,k:128,device:810e,offset_a:1,expect_error:16-byte-aligned
# A zero warp dimension must be rejected before tile division or JIT.
DenseGemm,data_type:bf16,m:7,n:16,k:128,device:810e,configs:[20,32,64,32,0,32,2],expect_error:invalid BF16 config
# WN8 compiles but oversteps the 810E MMA shared tile; reject it on the host.
DenseGemm,data_type:bf16,m:7,n:16,k:128,device:810e,configs:[20,16,32,32,16,8,2],expect_error:invalid BF16 config
# Low-budget fallback selects a valid N warp and two complete short-K stages.
DenseGemm,data_type:bf16,m:7,n:16,k:96,device:810e,num_sms:1
# tc01 cute-free: M/N/K tails, aliased C and a bounded persistent grid.
DenseGemm,data_type:bf16,m:37,n:41,k:160,device:810e,cute_free:1,warp_on_k:1,num_sms:1,accumulate:alias
# WarpOnK=4 reduces in FP32 before the BF16 cancellation/addition conversion.
DenseGemm,data_type:bf16,m:17,n:40,k:544,device:810e,cute_free:1,warp_on_k:4,configs:[20,32,64,256,16,32,2],accumulate:alias,pattern:cancellation
# Unsupported K slices fail before JIT/launch.
DenseGemm,data_type:bf16,m:17,n:40,k:512,device:810e,cute_free:1,warp_on_k:4,configs:[20,32,64,64,16,32,2],expect_error:two MMA K steps

# --- DenseGemm / int8 ---
# Small M with N/K tails, retained from the legacy shape sweep.
DenseGemm,data_type:int8,m:64,n:2112,k:576
DenseGemm,data_type:int8,m:2048,n:4096,k:7168
DenseGemm,data_type:int8,m:2048,n:512,k:7168

# --- DenseGemm / bf16_bf16_fp32 ---
# The last N tile uses a 16-column mainloop in the same launch; M/K also have tails.
DenseGemm,data_type:bf16_bf16_fp32,m:1025,n:2056,k:1056,device:810e,accumulate:alias
# Short-K unrolling with FP32 output and a separate accumulation input.
DenseGemm,data_type:bf16_bf16_fp32,m:96,n:8192,k:448,device:810e,accumulate:separate
DenseGemm,data_type:bf16_bf16_fp32,m:2,n:8192,k:7168
# Direct split-K product with FP32 output and separate C/D.
DenseGemm,data_type:bf16_bf16_fp32,m:32,n:128,k:6144,device:810e,accumulate:separate
# WarpOnK=2, M/K tails and separate C/D with FP32 output.
DenseGemm,data_type:bf16_bf16_fp32,m:65,n:136,k:1056,device:810e,cute_free:1,warp_on_k:2,configs:[20,64,64,64,32,32,2],accumulate:separate

# --- DenseGemm / fp32 (full FP32 operands, CPU FP64 reference) ---
# Vector load tail, scalar load via misalignment, and static specialization.
DenseGemm,data_type:fp32,m:7,n:9,k:516,device:810e
DenseGemm,data_type:fp32,m:7,n:9,k:512,device:810e,offset_a:1
DenseGemm,data_type:fp32,m:36,n:32,k:4096,device:810e
# Long unaligned rows: packing and the product must preserve full FP32 accuracy.
DenseGemm,data_type:fp32,m:36,n:32,k:4097,device:810e,offset_a:1
# Shared-memory FP32 path: vector K tail and misaligned scalar K tail.
DenseGemm,data_type:fp32,m:160,n:512,k:4096,device:810e
DenseGemm,data_type:fp32,m:129,n:130,k:255,device:810e,offset_a:1
# Narrow-output split-K: scalar loads, final partial BK16, and FP32 reduction.
DenseGemm,data_type:fp32,m:257,n:32,k:4100,device:810e,offset_a:1

