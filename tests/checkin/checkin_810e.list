GroupedNoPad,data_type:bf16,groups:16,m:4096,n:4096,k:7168,distribution:gaussian
GroupedNoPad,data_type:bf16,groups:128,m:1088,n:384,k:4096,em:9,distribution:[1,30,1,1,1,5,1,7,0,1,3,0,2,21,0,34,1,44,5,1,7,1,0,8,0,36,1,2,1,3,2,0,1,21,0,9,4,44,3,1,1,2,15,0,0,1,10,1,2,0,3,3,2,36,0,2,45,1,2,0,86,0,0,0,2,4,0,0,1,0,1,3,2,31,0,58,0,1,0,0,0,0,15,1,2,0,17,61,1,4,0,0,1,2,16,3,3,1,2,1,0,0,0,2,85,0,1,0,1,41,10,1,0,39,0,10,0,3,3,0,12,0,55,1,1,1,16,58]

