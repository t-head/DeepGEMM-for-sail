# DeepGEMM PR check-in caselist for Zhenwu 810E
# Run with: python tests/run_deep_gemm.py --caselist tests/checkin/checkin_810e.list
# Minimal per-type correctness set: each gemm type / dtype keeps a small number of
# representative shapes only. FP4/FP8/tf32/w4fa16 are 890P-only and are
# skipped on 810E by design.
# Sections are split per UT type; append new cases under the matching section.

# ============ DenseGemm ============

# --- DenseGemm / bf16 ---
DenseGemm,data_type:bf16,m:2048,n:4096,k:7168
DenseGemm,data_type:bf16,m:2048,n:512,k:7168
DenseGemm,data_type:bf16,m:256,n:4096,k:7168
DenseGemm,data_type:bf16,m:256,n:512,k:7168

# --- DenseGemm / int8 ---
DenseGemm,data_type:int8,m:2048,n:4096,k:7168
DenseGemm,data_type:int8,m:2048,n:512,k:7168

# ============ GroupedMasked ============

# --- GroupedMasked / int8 ---
GroupedMasked,data_type:int8,groups:16,m:4096,n:1024,k:7168,em:256,distribution:zipf
GroupedMasked,data_type:int8,groups:256,m:65536,n:4096,k:7168,em:256,distribution:uniform

# --- GroupedMasked / bf16 ---
GroupedMasked,data_type:bf16,groups:16,m:4096,n:4096,k:7168,em:12,distribution:zipf
GroupedMasked,data_type:bf16,groups:16,m:4096,n:4096,k:7168,em:12,distribution:[45,200,30,18,13,21,31,3,5,17,17,16,18,15,18,13]

# ============ GroupedNoPad ============

