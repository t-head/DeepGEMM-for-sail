HcPrenormGemm,data_type:tf32,m:3,n:24,k:16384
HcPrenormGemm,data_type:tf32,m:16,n:24,k:28672
HcPrenormGemm,data_type:tf32,m:24,n:24,k:20480
HcPrenormGemm,data_type:tf32,m:32,n:24,k:16384
HcPrenormGemm,data_type:tf32,m:60,n:24,k:20480
HcPrenormGemm,data_type:tf32,m:128,n:24,k:16384
HcPrenormGemm,data_type:tf32,m:1248,n:24,k:20480
HcPrenormGemm,data_type:tf32,m:4096,n:24,k:16384
HcPrenormGemm,data_type:tf32,m:8192,n:24,k:28672
HcPrenormGemm,data_type:tf32,m:8192,n:24,k:16384
HcPrenormGemm,data_type:tf32,m:9984,n:24,k:20480
HcPrenormGemm,data_type:tf32,m:64,n:8,k:128
