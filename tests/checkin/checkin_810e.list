BatchGemm,data_type:int8,groups:128,m:4096,n:128,k:512,quant_type:channel,expr:bhr,hdr->bhd
BatchGemm,data_type:int8,groups:128,m:64,n:512,k:128,quant_type:channel,expr:bhr,hdr->bhd
