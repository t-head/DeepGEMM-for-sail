# ============ BatchGemm ============

# --- BatchGemm / bf16 (native strided API, not quantized einsum) ---
# Unaligned output selects Direct BK32/stages=2; padded pitches and broadcast A.
BatchGemm,data_type:bf16,groups:3,m:37,n:41,k:64,device:810e,layout:padded,broadcast:a
# Default TSM, interleaved padded output and broadcast B.
BatchGemm,data_type:bf16,groups:3,m:37,n:40,k:128,device:810e,layout:interleaved_padded,broadcast:b
# Wide N / five BK32 tiles, aligned padded inputs, and a one-CU persistent launch.
BatchGemm,data_type:bf16,groups:8,m:257,n:512,k:160,device:810e,layout:padded,padding_a:32,padding_b:32,broadcast:a,num_sms:1
# Reject intersecting rows across batches before any output write.
BatchGemm,data_type:bf16,groups:2,m:3,n:16,k:128,device:810e,out_stride:[24,32,1],expect_error:overlap
# Invalid K must be rejected before packing a non-native input view.
BatchGemm,data_type:bf16,groups:2,m:3,n:16,k:32,device:810e,layout:interleaved_padded,b_stride:[2048,64,2],expect_error:k_tiles

# N-contiguous B with overlapping columns and descriptor rebasing, at a reduced CU budget.
BatchGemm,data_type:bf16,groups:3,m:33,n:96,k:128,device:810e,layout:interleaved_padded,b_stride:[8192,1,64],num_sms:1
# Overlapping K-contiguous B rows, broadcast A, and one final BF16 conversion.
BatchGemm,data_type:bf16,groups:3,m:31,n:80,k:256,device:810e,layout:interleaved_padded,a_stride:[0,264,1],b_stride:[16384,128,1]
# Non-power-of-two K96 segments cover K288 with complete BK32 tiles.
BatchGemm,data_type:bf16,groups:3,m:31,n:80,k:288,device:810e,layout:interleaved_padded,a_stride:[0,296,1],b_stride:[16384,152,1]

