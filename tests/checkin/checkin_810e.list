BatchGemm,data_type:int8,groups:128,m:64,n:512,k:128,quant_type:channel,expr:bhr,hdr->bhd
BatchGemm,data_type:int8,groups:128,m:4096,n:512,k:128,quant_type:channel,expr:bhr,hdr->bhd
BatchGemm,data_type:int8,groups:8,m:64,n:1024,k:4096,quant_type:channel,expr:bhr,hdr->bhd
BatchGemm,data_type:int8,groups:8,m:4096,n:1024,k:4096,quant_type:channel,expr:bhr,hdr->bhd
BatchGemm,data_type:int8,groups:16,m:64,n:1024,k:4096,quant_type:channel,expr:bhr,hdr->bhd
BatchGemm,data_type:int8,groups:16,m:4096,n:1024,k:4096,quant_type:channel,expr:bhr,hdr->bhd
# Alternate batch output layout (groups=h, m=b, n=d, k=r).
BatchGemm,data_type:int8,groups:8,m:32,n:128,k:512,quant_type:channel,expr:bhr,hdr->hbd

