GroupedFused,data_type:bf16,groups:256,num_token:256,topk:8,n:6144,k:128
GroupedFused,data_type:bf16,groups:256,num_token:4096,topk:8,n:6144,k:128
GroupedFused,data_type:bf16,groups:256,num_token:64,topk:8,n:256,k:6144

