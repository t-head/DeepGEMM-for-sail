# DeepGEMM PR check-in caselist for Zhenwu 810E
# Run with: python tests/run_deep_gemm.py --caselist tests/checkin/checkin_810e.list
# Minimal per-type correctness set: each gemm type / dtype keeps a small number of
# representative shapes only. FP4/FP8 and W4A16 MXFP4 MMA require 890P.
# W4A16 INT4 and MXFP4 VALU paths are covered on both 810E and 890P.
# MQA coverage focuses on INT8, plus one BF16 smoke case.
# Sections are split per UT type; append new cases under the matching section.

# ============ DenseGemm ============

# --- DenseGemm / bf16 ---
# Small M with N/K tails, retained from the legacy shape sweep.
DenseGemm,data_type:bf16,m:64,n:2112,k:576
DenseGemm,data_type:bf16,m:2048,n:4096,k:7168
DenseGemm,data_type:bf16,m:2048,n:512,k:7168
DenseGemm,data_type:bf16,m:256,n:4096,k:7168
DenseGemm,data_type:bf16,m:256,n:512,k:7168

# --- DenseGemm / int8 ---
# Small M with N/K tails, retained from the legacy shape sweep.
DenseGemm,data_type:int8,m:64,n:2112,k:576
DenseGemm,data_type:int8,m:2048,n:4096,k:7168
DenseGemm,data_type:int8,m:2048,n:512,k:7168

# --- DenseGemm / bf16_bf16_fp32 ---
DenseGemm,data_type:bf16_bf16_fp32,m:2048,n:4096,k:7168
DenseGemm,data_type:bf16_bf16_fp32,m:132,n:3072,k:1536
DenseGemm,data_type:bf16_bf16_fp32,m:2,n:8192,k:7168

